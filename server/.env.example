# MongoDB Connection
# Replace with your MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sample_airbnb?retryWrites=true&w=majority"

# OPTIONAL: Voyage AI Configuration (required for Vector Search and the embedding backfill)
# Get your API key from https://www.voyageai.com/
# VOYAGE_API_KEY=your_voyage_api_key

# Write Operations
# The create, update, delete and embedding backfill endpoints have no authentication, so they are
# disabled by default and every write returns 403. Leave this true for local development; leave it
# UNSET on any deployment reachable from the internet, which keeps that deployment read-only.
WRITE_ENABLED=true

# Server Configuration
PORT=3001

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
# Log level: TRACE, DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO
# Optional: Path to log file (if not set, logs only to console)
# LOG_FILE=app.log
