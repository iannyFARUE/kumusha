# Base URL of the Kumusha backend API.
#
# The NEXT_PUBLIC_ prefix is required: this value is read from client components, and Next.js only
# inlines prefixed variables into the browser bundle. Renaming it without the prefix makes the
# value undefined in the browser, which silently falls back to http://localhost:3001.
#
# Defaults to http://localhost:3001 when unset, which matches the backend's default PORT.
NEXT_PUBLIC_API_URL=http://localhost:3001
